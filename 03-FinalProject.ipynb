    "needed = [\"Parameters\", \"Training compute (FLOP)\"]\n",
    "missing_needed = [c for c in needed if c not in epoch_df.columns]\n",
    "if missing_needed:\n",
    "    raise ValueError(f\"Epoch dataset missing required columns: {missing_needed}\")\n",

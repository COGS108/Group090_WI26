    "import statsmodels.api as sm\n",
    "\n",
    "epoch_df = pd.read_json(EPOCH_PATH, lines=True)\n",
    "\n",
    "sub = epoch_df.dropna(subset=[\"Parameters\", \"Training compute (FLOP)\"]).copy()\n",
    "sub = sub[(sub[\"Parameters\"] > 0) & (sub[\"Training compute (FLOP)\"] > 0)]\n",
    "\n",
    "sub[\"log_params\"] = np.log10(sub[\"Parameters\"])\n",
    "sub[\"log_train_flop\"] = np.log10(sub[\"Training compute (FLOP)\"])\n",
    "\n",
    "X = sm.add_constant(sub[\"log_params\"])\n",
    "y = sub[\"log_train_flop\"]\n",
    "\n",
    "model = sm.OLS(y, X).fit()\n",
    "print(model.summary())"
   ]
